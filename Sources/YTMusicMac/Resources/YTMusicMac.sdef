<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary title="YT Music for Mac Terminology">
    <suite name="Standard Suite" code="core" description="Application commands.">
        <command name="quit" code="aevtquit" description="Quit the application.">
            <cocoa class="NSQuitCommand"/>
        </command>
        <class name="application" code="capp" description="YT Music for Mac.">
            <cocoa class="NSApplication"/>
            <responds-to command="quit">
                <cocoa method="terminate:"/>
            </responds-to>
        </class>
    </suite>
    <suite name="Music Suite" code="YTMc" description="Playback controls and current player status.">
        <command name="play" code="YTMcplay" description="Start or resume the selected song.">
            <cocoa class="YTMusicPlayCommand"/>
            <result type="boolean" description="Whether the playback request was accepted."/>
        </command>
        <command name="play video" code="YTMcpvid" description="Look up an exact YouTube video ID and start that song.">
            <cocoa class="YTMusicPlayVideoCommand"/>
            <direct-parameter type="text" description="An 11-character YouTube video ID."/>
            <result type="text" description="The video ID queued for playback."/>
        </command>
        <command name="pause" code="YTMcpaus" description="Pause playback.">
            <cocoa class="YTMusicPauseCommand"/>
            <result type="boolean" description="Whether the pause request was accepted."/>
        </command>
        <command name="set volume" code="YTMcvolu" description="Set the player's volume.">
            <cocoa class="YTMusicSetVolumeCommand"/>
            <direct-parameter type="real" description="Volume from 0.0 to 1.0."/>
            <result type="boolean" description="Whether the volume was set."/>
        </command>
        <command name="get player info" code="YTMcinfo" description="Read the current playback state as JSON.">
            <cocoa class="YTMusicGetPlayerInfoCommand"/>
            <result type="text" description="Playing, buffering, sign-in state, current video ID, position, duration, volume, queue count and a generic playback error when present."/>
        </command>
    </suite>
</dictionary>
