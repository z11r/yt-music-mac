<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%@ · %lld images</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$@ · %2$#@songs@</string>
		<key>songs</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld image</string>
			<key>other</key>
			<string>%lld images</string>
		</dict>
	</dict>
	<key>%lld Minutes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@songs@</string>
		<key>songs</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld minute</string>
			<key>other</key>
			<string>%lld minutes</string>
		</dict>
	</dict>
	<key>%lld hours</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@songs@</string>
		<key>songs</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld heure</string>
			<key>other</key>
			<string>%lld heures</string>
		</dict>
	</dict>
	<key>%lld matching loaded library collections</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@songs@</string>
		<key>songs</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld collection chargée correspondante</string>
			<key>other</key>
			<string>%lld collections chargées correspondantes</string>
		</dict>
	</dict>
	<key>%lld of %lld songs</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$lld sur %2$#@songs@</string>
		<key>songs</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld titre</string>
			<key>other</key>
			<string>%lld titres</string>
		</dict>
	</dict>
	<key>%lld songs</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@songs@</string>
		<key>songs</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld titre</string>
			<key>other</key>
			<string>%lld titres</string>
		</dict>
	</dict>
	<key>%lld songs loaded</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@songs@</string>
		<key>songs</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld titre chargé</string>
			<key>other</key>
			<string>%lld titres chargés</string>
		</dict>
	</dict>
	<key>%lld songs selected</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@songs@</string>
		<key>songs</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld titre sélectionné</string>
			<key>other</key>
			<string>%lld titres sélectionnés</string>
		</dict>
	</dict>
	<key>%lld songs · %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@songs@ · %2$@</string>
		<key>songs</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld titre</string>
			<key>other</key>
			<string>%lld titres</string>
		</dict>
	</dict>
	<key>%lld unavailable items excluded from the loaded pages</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@songs@</string>
		<key>songs</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld élément indisponible exclu des pages chargées</string>
			<key>other</key>
			<string>%lld éléments indisponibles exclus des pages chargées</string>
		</dict>
	</dict>
	<key>At least %@ remaining · %lld unknown</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Au moins %1$@ restantes · %2$#@songs@</string>
		<key>songs</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld durée inconnue</string>
			<key>other</key>
			<string>%lld durées inconnues</string>
		</dict>
	</dict>
	<key>Filtering searches the %lld loaded songs. Play All, Shuffle All, and Add All to Queue include the remaining pages.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@songs@</string>
		<key>songs</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Le filtre recherche parmi le %lld titre chargé. Tout lire, Tout mélanger et Tout ajouter à la file d’attente incluent les pages restantes.</string>
			<key>other</key>
			<string>Le filtre recherche parmi les %lld titres chargés. Tout lire, Tout mélanger et Tout ajouter à la file d’attente incluent les pages restantes.</string>
		</dict>
	</dict>
	<key>Loading all songs… %lld loaded</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@songs@</string>
		<key>songs</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Chargement de tous les titres… %lld chargé</string>
			<key>other</key>
			<string>Chargement de tous les titres… %lld chargés</string>
		</dict>
	</dict>
</dict>
</plist>
